# =====================================================================
# ExpoHub Backend - Environment Configuration (.env)
# =====================================================================

# 1. Database Connection URL:
# PostgreSQL on Render (Internal Database URL recommended when web service & db are in same Render region):
# DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a.oregon-postgres.render.com/expohub_db
# 
# SQLite (Default local development):
DATABASE_URL=sqlite:///booth_system.db

# 2. Allowed CORS Origins:
# In Production with Vercel Frontend, set to your Vercel domain(s):
# ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 3. Cookie & Cross-Domain Security:
# Set COOKIE_SECURE=1 in production when using HTTPS (Render / Vercel)
COOKIE_SECURE=0

# Cookie SameSite: 'none' for cross-domain (Vercel -> Render), 'lax' for local dev
# Automatically defaults to 'none' if COOKIE_SECURE=1, or 'lax' if COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# 4. First-Time Setup Security:
# Set ALLOW_REMOTE_SETUP=1 on Render so you can complete the initial Admin Setup from your browser
ALLOW_REMOTE_SETUP=1

# 5. Server Binding
HOST=0.0.0.0
PORT=8000
