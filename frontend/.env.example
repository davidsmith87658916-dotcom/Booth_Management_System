# Backend API Base URL
# 1. For Local Development (with Vite Proxy):
VITE_API_BASE=/api

# 2. For Production on Vercel:
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables:
# VITE_API_BASE=https://expohub-backend.onrender.com/api
